{
  "info": {
    "name": "SABDA LMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Jalankan 'Login' lebih dulu; token tersimpan otomatis di variabel {{token}}. Ganti base_url dengan URL Vercel Anda."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://nama-project.vercel.app"
    },
    {
      "key": "token",
      "value": ""
    }
  ],

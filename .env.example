# Salin file ini menjadi .env untuk development lokal.
# Di Vercel, isi nilai yang sama lewat Settings > Environment Variables.
# JANGAN pernah commit file .env ke GitHub.

# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Gunakan "service_role" key (rahasia, hanya dipakai di server).
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key

# Secret untuk menandatangani JWT. Minimal 32 karakter acak.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_HOURS=24

# Origin yang boleh memanggil API dari browser (pisahkan dengan koma). "*" = semua.
CORS_ORIGINS=*
